# 号池本地开发专用：复制为 frontend/.env.local。
# .env.local 同时供 pnpm dev 与 pnpm preview 使用，已被 Git 忽略。
# VITE_* 会暴露给浏览器，不能放数据库密码、JWT 密钥或其他秘密。
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=3001
VITE_DEV_STRICT_PORT=true
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8081

# preview 与 dev 共用号池前端端口，因此二者不能同时启动。
VITE_PREVIEW_HOST=127.0.0.1
VITE_PREVIEW_PORT=3001
VITE_PREVIEW_STRICT_PORT=true

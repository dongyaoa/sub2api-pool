[Unit]
Description=Sub2API Pool image updater
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/sub2api-pool-updater/config.json

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/sub2api-pool-updater --config /etc/sub2api-pool-updater/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
